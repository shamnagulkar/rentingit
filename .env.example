# Database (SQLite for dev, Postgres for prod)
DATABASE_URL=file:./db/custom.db

# NextAuth (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=replace-with-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# Cloudinary (https://cloudinary.com — free 25GB)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=rentingit_unsigned
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (https://resend.com — free 3,000 emails/month)
RESEND_API_KEY=
RESEND_FROM_EMAIL=RENTINGIT <noreply@rentingit.app>

# Chat service URL (Railway URL in prod)
CHAT_SERVICE_URL=http://localhost:3003
